# This repo is public-facing and holds real configuration, so the rules below
# lean towards refusing anything that looks like key material or machine-local
# state. Secrets that must be versioned belong in sops-encrypted secrets.yaml
# (see .sops.yaml), never in plaintext.

# --- key material -----------------------------------------------------------
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.kbx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk
# age/sops identities. secrets.yaml is ciphertext and stays tracked.
*.agekey
key.txt
keys.txt
!secrets.yaml

# --- credentials and tokens -------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
.netrc
.pgpass
.npmrc
.pypirc
*credentials*.json
*client_secret*.json
*service-account*.json
*service_account*.json
.aws/credentials
auth.json
token
*.token
gh_token*
*password*
restic-password
.secrets
secrets.local.*

# --- backups and merge debris that leak resolved secrets --------------------
# `settings.json.bak.<epoch>` style backups routinely contain expanded keys.
*.bak
*.bak.*
*.orig
*.rej
*.old
*.save
*~

# --- machine-local state ----------------------------------------------------
.dotfiles
tmux/.tmux/plugins/*
nvim/.config/nvim/lazy-lock.json
*.log
*.pid
*.sock
.direnv/
.mise.local.toml
mise.local.toml
# Agent review screenshots (approved_/rejected_ refs).
.ai/

# --- caches and build output ------------------------------------------------
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/
.venv/
venv/
node_modules/
.cache/

# --- editor and OS noise ----------------------------------------------------
*.swp
*.swo
.DS_Store
Thumbs.db
.idea/
*.code-workspace

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Written into linked config directories by the tools themselves, not
# declared here: skills installed by agent-setup, and television's stock
# channels from `tv update-channels`. A channel of your own needs a line.
/agents/.agents/skills/
!/agents/.agents/skills/agent-sidebar/
!/agents/.agents/skills/agent-sidebar/**
/agents/.agents/.skill-lock.json
/television/.config/television/cable/*
!/television/.config/television/cable/agents.toml
!/television/.config/television/cable/dirs.toml
!/television/.config/television/cable/projects.toml
!/television/.config/television/cable/sesh.toml

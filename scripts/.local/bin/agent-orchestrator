#!/usr/bin/env bash
# agent-orchestrator - Hugin, Rogvi's desk: one claude session that keeps
# track of all the other agents, shown in a popup.
#
# Usage: agent-orchestrator [COMMAND]
#
#   toggle   show Hugin in a popup, or close the popup when you
#            are in it (M-1; the default). In another popup, such as M-3's,
#            it takes that one's place rather than open inside it.
#   start    create Hugin's session if there is none, without
#            showing it; prints the pane running Hugin, and fails when
#            an existing session does not have exactly one
#   pane     print the pane running the Hugin agent; fails unless there
#            is exactly one
#
# Hugin is `claude --agent hugin --remote-control Hugin`, in the tmux
# session "hugin". The first toggle or start creates the session with a
# shell in Hugin's home and types the command into it, so the session
# outlives claude and closing the popup only hides it.
#
# Remote Control is on for Hugin alone, so the Claude app lists it as
# "Hugin" and no other agent. The sidebar's restore starts an agent again
# with the options it was started with, so a restored Hugin keeps it too.
#
# It runs on the claude account the tmux option @agent-orchestrator-account
# names (agent-sidebar-tmux accounts lists the names; tmux.conf sets it).
# When this machine has no such account, it says so and starts nothing.
# Unset, it runs on the account of whatever creates the session: for M-1,
# the tmux server's own.
#
# agent-sidebar-tmux comes from the agent-sidebar tmux plugin, which puts
# it on the tmux server's PATH.
#
# The home is the main worktree of the hugin repo (rogvid/hugin), cloned
# with git-wt to ~/personal/projects/hugin. Its .claude/agents/hugin.md is
# Hugin's identity, and agent-scan shows the session as project hugin.

set -euo pipefail

readonly session="hugin"
readonly launch="claude --agent hugin --remote-control Hugin"
readonly home="${HUGIN_HOME:-${HOME}/personal/projects/hugin/main}"

usage() {
    sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
}

# Behind a key binding stderr would open a pane of its own, so a toggle
# says what went wrong on the status line.
complain() {
    if [[ "${command}" == toggle ]]; then
        tmux display-message -d 5000 "agent-orchestrator: $1"
    else
        echo "agent-orchestrator: $1" >&2
    fi
}

# The folder of the claude account to run on, in `account`: the one
# @agent-orchestrator-account names, else the caller's, else "" for claude's
# default. Fails, having said why, when the named one is not here: starting
# on another account instead would be worse than not starting.
pick_account() {
    local name
    name="$(tmux show-options -gqv @agent-orchestrator-account)"
    account="${CLAUDE_CONFIG_DIR:-}"
    [[ -n "${name}" ]] || return 0
    if ! command -v agent-sidebar-tmux >/dev/null; then
        complain "@agent-orchestrator-account needs agent-sidebar-tmux, from the agent-sidebar tmux plugin"
        return 1
    fi
    account="$(agent-sidebar-tmux accounts |
        awk -F '\t' -v n="${name}" '$1 == "claude" && $2 == n { print $3; exit }')"
    if [[ -z "${account}" ]]; then
        complain "no claude account ${name} on this machine (@agent-orchestrator-account; see: agent-sidebar-tmux accounts)"
        return 1
    fi
}

# claude asks whether to trust a folder the first time it starts in one,
# and Enter answers "No, exit". The home is ours, so it is trusted up front
# the way claude records a yes itself: projects[FOLDER].hasTrustDialogAccepted
# in the account's .claude.json. That trusts this one folder on this one
# account and nothing else. claude re-reads the file before each write, so a
# claude already running on the account keeps the entry.
trust_home() {
    local folder="$1" config key tmp
    if [[ -n "${folder}" ]]; then
        config="${folder}/.claude.json"
    else
        config="${HOME}/.claude.json"
    fi
    # Through a link to the file itself, which the mv below would replace.
    config="$(realpath -m "${config}")"
    key="$(realpath "${home}")"
    if [[ -f "${config}" ]] && jq -e --arg key "${key}" \
        '.projects[$key].hasTrustDialogAccepted == true' "${config}" >/dev/null 2>&1; then
        return 0
    fi
    mkdir -p "$(dirname "${config}")"
    # mktemp makes the file 0600, like the one it replaces, and in the same
    # folder, so the mv is atomic.
    tmp="$(mktemp "${config}.XXXXXX")"
    if ! {
        if [[ -s "${config}" ]]; then
            jq --arg key "${key}" '.projects[$key].hasTrustDialogAccepted = true' \
                "${config}" >"${tmp}"
        else
            jq -n --arg key "${key}" '{projects: {($key): {hasTrustDialogAccepted: true}}}' >"${tmp}"
        fi && mv "${tmp}" "${config}"
    }; then
        rm -f "${tmp}"
        complain "could not mark ${home} trusted in ${config}"
        return 1
    fi
}

# The one pane in Hugin's session whose process tree runs `--agent hugin`, as
# agent-scan reads it. The session's active pane can be a shell split beside it.
agent_pane() {
    local panes
    panes="$(agent-scan --json | jq -r --arg prefix "${session}:" \
        '.[] | select(.role == "hugin" and (.target | startswith($prefix))) | .pane_id')" || return 1
    # Two panes are two lines, which this does not match.
    [[ "${panes}" =~ ^%[0-9]+$ ]] || return 1
    echo "${panes}"
}

start() {
    if tmux has-session -t "=${session}" 2>/dev/null; then
        agent_pane || {
            complain "session ${session} does not have exactly one Hugin agent"
            return 1
        }
        return 0
    fi
    create_session
}

create_session() {
    local pane
    local -a session_env=()
    if [[ ! -e "${home}/.claude/agents/hugin.md" ]]; then
        complain "no Hugin at ${home} - run: git-wt clone git@github.com:rogvid/hugin.git ~/personal/projects/hugin"
        return 1
    fi
    pick_account || return 1
    trust_home "${account}" || return 1
    if [[ -n "${account}" ]]; then
        session_env=(-e "CLAUDE_CONFIG_DIR=${account}")
    fi
    pane="$(tmux new-session -d -P -F '#{pane_id}' -s "${session}" -c "${home}" \
        "${session_env[@]}")"
    # Typed into the shell rather than run as the session's command, so the
    # session outlives claude.
    tmux send-keys -t "${pane}" -l "${launch}"
    tmux send-keys -t "${pane}" Enter
    echo "${pane}"
}

# Whether a client process was started by the tmux server itself, as a
# popup's nested client is.
spawned_by_server() {
    local pid="$1" server_pid _
    server_pid="$(tmux display-message -p '#{pid}')"
    for _ in 1 2 3 4; do
        pid="$(ps -o ppid= -p "${pid}" 2>/dev/null | tr -d ' ')"
        if [[ -z "${pid}" || "${pid}" -le 1 ]]; then
            return 1
        fi
        if [[ "${pid}" == "${server_pid}" ]]; then
            return 0
        fi
    done
    return 1
}

toggle() {
    local current client_pid socket
    read -r current client_pid < <(tmux display-message -p '#{session_name} #{client_pid}')
    if [[ "${current}" == "${session}" ]]; then
        # In the popup, closing it is detaching its client. A terminal that
        # was switched to Hugin goes back where it came from
        # instead of being detached.
        if spawned_by_server "${client_pid}"; then
            tmux detach-client
        else
            tmux switch-client -l
        fi
        return 0
    fi
    # Not `start`: a session whose agent has exited still opens.
    if ! tmux has-session -t "=${session}" 2>/dev/null; then
        create_session >/dev/null || return 0
    fi
    # The popup's client attaches to this server by its socket: a bare
    # tmux in there would reach the default one.
    socket="$(tmux display-message -p '#{socket_path}')"
    tmux-popup -xC -yC -w80% -h75% -T ' hugin ' -E \
        "env -u TMUX tmux -S $(printf '%q' "${socket}") attach -t '=${session}'"
}

command="toggle"
case "${1:-toggle}" in
toggle | start | pane) command="${1:-toggle}" ;;
-h | --help)
    usage
    exit 0
    ;;
*)
    usage >&2
    exit 2
    ;;
esac

case "${command}" in
toggle) toggle ;;
start) start ;;
pane) agent_pane ;;
esac

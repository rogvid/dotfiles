#!/usr/bin/env bash
# Claude Code PreToolUse hook for AskUserQuestion: send questions to Hugin.
#
# A dialog blocks its pane and Hugin may not answer it. So while the tmux
# session "hugin" runs, every other tmux session is denied the tool and told
# how to reach Hugin instead. Outside tmux, in Hugin's session, or without
# exactly one running Hugin agent, the tool works as usual.
#
# No output and exit 0 allows the tool. Any error of this script's own ends
# there too, so a broken gate can never wedge a session.
#
# `agent-setup` registers it in each Claude Code settings.json.
set -euo pipefail
trap 'exit 0' EXIT

readonly hugin_session="hugin"

main() {
  [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] || return 0
  jq -e '.tool_name == "AskUserQuestion"' >/dev/null 2>&1 || return 0
  tmux has-session -t "=${hugin_session}" 2>/dev/null || return 0

  # A pane that is gone could not receive Hugin's answer.
  [[ "$(tmux display-message -p -t "${TMUX_PANE}" '#{pane_id}' 2>/dev/null)" == "${TMUX_PANE}" ]] || return 0
  if tmux list-panes -s -t "=${hugin_session}" -F '#{pane_id}' | grep -qxF "${TMUX_PANE}"; then
    return 0
  fi

  # Without exactly one Hugin agent, nobody could answer the question.
  local hugin_pane
  hugin_pane="$(agent-orchestrator pane 2>/dev/null)" || return 0
  [[ "${hugin_pane}" =~ ^%[0-9]+$ ]] || return 0

  jq -n --arg pane "${hugin_pane}" '{
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: (
        "Do not ask through this dialog: it blocks your pane and Hugin may not answer it.\n"
        + "1. Decide yourself anything that privacy, security, quality, simplicity or long-term maintainability settles, and name the decision in your report.\n"
        + "2. Send anything else to Hugin with `agent-msg send " + $pane + " \"...\"`, with the options and your recommendation, then end your turn. The answer is pasted into your pane."
      )
    }
  }'
}

main

#!/usr/bin/env bash
# Install the parts of the agent setup that dotfiles cannot carry.
#
# `mise bootstrap` links anything that is a file you own. This handles the rest: third-party
# programs with their own installers, and skills fetched from upstream repos. Vendoring
# either would mean fighting their updaters forever, so they are declared, not copied.
#
#   agent-setup            install what is missing
#   agent-setup --check    report what would change, touch nothing
#
# Safe to re-run. Links only the skill adapters Claude Code needs, and runs the agent-sidebar
# plugin's agent-sidebar-setup - run
# `mise bootstrap dotfiles apply` yourself once you are happy with what this reports.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
SKILL_LIST="${DOTFILES}/agents/.agents/skills.list"
PEON_DIR="${HOME}/.claude/hooks/peon-ping"
CHECK=0
[[ "${1:-}" == "--check" ]] && CHECK=1

say()  { printf '  %s\n' "$*"; }
head_() { printf '\n%s\n' "$*"; }
would() { (( CHECK )) && { say "would: $*"; return 1; }; return 0; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || { echo "missing required command: $1" >&2; exit 1; }
}

install_peon_ping() {
  head_ "peon-ping"
  if [[ -x "${PEON_DIR}/peon.sh" ]]; then
    say "already installed at ${PEON_DIR}"
    return
  fi
  say "not installed"
  would "curl -fsSL https://raw.githubusercontent.com/PeonPing/peon-ping/main/install.sh | bash" || return 0
  # Its installer owns this directory and registers its own hooks in settings.json.
  # We keep only config.json under version control; packs and state stay local.
  curl -fsSL https://raw.githubusercontent.com/PeonPing/peon-ping/main/install.sh | bash
  say "installed - run 'mise bootstrap dotfiles apply' to relink anything its installer replaced"
}

install_skills() {
  head_ "skills -> ~/.agents/skills"
  [[ -f "$SKILL_LIST" ]] || { say "no manifest at $SKILL_LIST"; return; }
  local repo skill missing=0
  while read -r repo skill; do
    [[ -z "${repo:-}" || "${repo:0:1}" == "#" ]] && continue
    if [[ -e "${HOME}/.agents/skills/${skill}" ]]; then
      say "present  ${skill}"
      continue
    fi
    missing=1
    would "npx -y skills add ${repo} --skill ${skill} -g -y -a claude-code" || continue
    say "adding   ${skill}"
    npx -y skills add "$repo" --skill "$skill" -g -y -a claude-code
    if [[ ! -e "${HOME}/.agents/skills/${skill}" ]]; then
      # Non-interactive installs land in ~/.claude/skills as a copy; move into
      # the canonical pool and replace with the adapter symlink.
      mv "${HOME}/.claude/skills/${skill}" "${HOME}/.agents/skills/${skill}"
      ln -s "../../.agents/skills/${skill}" "${HOME}/.claude/skills/${skill}"
    fi
  done < "$SKILL_LIST"
  (( missing )) || say "all declared skills present"
}

# Every harness but Claude Code reads ~/.agents/skills natively. Claude Code reads
# only its config dir, and each CLAUDE_CONFIG_DIR profile (~/.claude-*) is its own,
# so every one gets a link per pool skill. Links into the pool whose skill is gone
# are pruned; anything else in there belongs to Claude Code and is left alone.
link_claude_skills() {
  head_ "skills -> Claude Code config dirs"
  local pool="${HOME}/.agents/skills" cfg dir skill name link changed=0
  for cfg in "${HOME}/.claude" "${HOME}"/.claude-*/; do
    cfg="${cfg%/}"
    [[ -d "$cfg" ]] || continue
    dir="${cfg}/skills"
    for skill in "$pool"/*/; do
      [[ -f "${skill}SKILL.md" ]] || continue
      name="$(basename "$skill")"
      link="${dir}/${name}"
      [[ -L "$link" && -e "$link" ]] && continue
      if [[ -e "$link" && ! -L "$link" ]]; then
        say "skipped  ${link} - not a symlink"
        continue
      fi
      changed=1
      would "link ${link}" || continue
      mkdir -p "$dir"
      ln -sfn "../../.agents/skills/${name}" "$link"
      say "linked   ${link}"
    done
    for link in "$dir"/*; do
      [[ -L "$link" && ! -e "$link" && "$(readlink "$link")" == *".agents/skills/"* ]] || continue
      changed=1
      would "remove dangling ${link}" || continue
      rm "$link"
      say "removed  ${link}"
    done
  done
  (( changed )) || say "every Claude Code config dir links every pool skill"
}

# TPM and the plugins ~/.tmux.conf lists, agent-sidebar among them. TPM's
# installer reads the list itself, so no tmux needs to be running.
install_tmux_plugins() {
  head_ "tmux plugins (TPM)"
  local tpm="${HOME}/.tmux/plugins/tpm"
  if [[ ! -x "${tpm}/bin/install_plugins" ]]; then
    say "TPM not installed"
    would "git clone https://github.com/tmux-plugins/tpm ${tpm}" || return 0
    git clone --quiet https://github.com/tmux-plugins/tpm "$tpm"
  fi
  would "${tpm}/bin/install_plugins" || return 0
  "${tpm}/bin/install_plugins" | sed 's/^/  /'
}

# The agent-sidebar tmux plugin's own setup: its skill, its television
# channels, and agent-usage-tap in front of each Claude Code statusline.
agent_sidebar_setup() {
  head_ "agent-sidebar"
  local setup="${AGENT_SIDEBAR_PLUGIN:-${HOME}/.tmux/plugins/agent-sidebar}/bin/agent-sidebar-setup"
  if [[ ! -x "$setup" ]]; then
    say "not installed - is it listed in ~/.tmux.conf? (set -g @plugin 'rogvid/agent-sidebar')"
    return 0
  fi
  if (( CHECK )); then
    "$setup" --check | sed 's/^/  /'
  else
    "$setup" | sed 's/^/  /'
  fi
}

report_undeclared() {
  head_ "in the pool but not declared"
  local declared owned
  declared="$( { grep -vE '^\s*#|^\s*$' "$SKILL_LIST" || true; } | awk '{print $2}')"
  # Skills dotfiles tracks are its own, not leftovers; `npx skills remove` would delete them.
  owned="$( { git -C "$DOTFILES" ls-files -- agents/.agents/skills 2>/dev/null || true; } | cut -d/ -f4)"
  comm -23 <(ls "${HOME}/.agents/skills" 2>/dev/null | sort) <(printf '%s\n' "$declared" "$owned" | sort -u) \
    | sed 's/^/  /' | grep . || say "none"
  say "remove any you no longer want with: npx skills remove <name>"
}

main() {
  require_cmd curl
  require_cmd npx
  (( CHECK )) && echo "check mode - nothing will be modified"
  install_peon_ping
  install_skills
  link_claude_skills
  install_tmux_plugins
  agent_sidebar_setup
  report_undeclared
  head_ "next"
  say "mise bootstrap dotfiles apply"
}

main "$@"

#!/usr/bin/env bash
# opencode-free PROMPT... - one `opencode run` on a free OpenCode model, for
# reviews and evals when the Claude account's usage limit is reached.
#
# Models are tried in order until one succeeds: OPENCODE_FREE_MODELS, default
# big-pickle, then nemotron-3-ultra-free. Both found a planted bug in a review
# test; space-bunny-free missed it and mimo-v2.6-flash-free took minutes.
#
# The run never reaches your tmux server. Models test their theories by
# running tmux, and one inheriting TMUX_PANE sent keys into the calling pane.
# So TMUX and TMUX_PANE are dropped and TMUX_TMPDIR points at a throwaway
# directory: any tmux it runs starts a private server there, killed after.
#
# OPENCODE_FREE_TMUX_TMPDIR=DIR instead hands the run the tmux server the
# caller started at DIR's default socket, such as an eval's sandbox, together
# with TMUX_PANE, which then names a pane in that server. It is left running.
set -euo pipefail

if [[ $# -eq 0 ]]; then
    sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2
    exit 2
fi

read -r -a models <<<"${OPENCODE_FREE_MODELS:-big-pickle nemotron-3-ultra-free}"

if [[ -n "${OPENCODE_FREE_TMUX_TMPDIR:-}" ]]; then
    socket="${OPENCODE_FREE_TMUX_TMPDIR}/tmux-$(id -u)/default"
    if ! tmux -S "${socket}" has-session 2>/dev/null; then
        echo "opencode-free: no tmux server at ${socket}" >&2
        exit 2
    fi
    tmux_env=(TMUX="${socket},0,0" TMUX_TMPDIR="${OPENCODE_FREE_TMUX_TMPDIR}")
else
    sandbox="$(mktemp -d)"
    # By socket path: plain `tmux kill-server` here would follow this shell's
    # own TMUX to the caller's server and kill every session in it.
    cleanup() {
        tmux -S "${sandbox}/tmux-$(id -u)/default" kill-server 2>/dev/null || true
        rm -rf "${sandbox}"
    }
    trap cleanup EXIT
    tmux_env=(-u TMUX -u TMUX_PANE TMUX_TMPDIR="${sandbox}")
fi

for model in "${models[@]}"; do
    if env "${tmux_env[@]}" opencode run -m "opencode/${model}" "$@"; then
        exit 0
    fi
    echo "opencode-free: opencode/${model} failed, trying the next model" >&2
done
echo "opencode-free: every model failed: ${models[*]}" >&2
exit 1

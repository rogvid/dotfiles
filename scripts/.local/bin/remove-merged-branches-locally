#!/usr/bin/env bash
# Check if ripgrep exists
if ! command -v rg >/dev/null 2>&1; then
  echo "Command expects ripgrep to be installed" >&2
  exit 1
fi
git branch --merged | rg -v '(^\*|master|main|dev)' >/tmp/merged-branches && vi /tmp/merged-branches && xargs git branch -d </tmp/merged-branches
# Prune tracking of remote branches that don't exist anymore
git remote prune origin
# Maybe swap with this:
# git fetch -p ; git branch -r | awk '{print $1}' | egrep -v -f /dev/fd/0 <(git branch -vv | grep origin) | awk '{print $1}' | xargs git branch -d

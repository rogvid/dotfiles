#!/bin/bash
set -eu

here="$(dirname "$0")"

restic backup \
  -r ~/restic-repo \
  --exclude-caches \
  --files-from "$here/restic-include" \
  --exclude-file "$here/restic-exclude" \
  --password-file "$here/restic-password"


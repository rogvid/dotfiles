#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
  selected=$1
else
  # Locate projects/ container dirs in one pass.
  # Prune hidden + heavy dirs so we don't walk node_modules, .cache, etc.
  containers=$(find ~ -maxdepth 6 \
    \( -path '*/.*' -o -name node_modules -o -name target -o -name venv -o -name __pycache__ -o -name dist -o -name build \) -prune \
    -o -type d \( -path '*/work/*/projects' -o -path '*/personal/projects' \) -print 2>/dev/null)

  # Plain clones inside each projects/ folder, and every worktree of the
  # projects git-wt lays out there (a .bare next to a folder per worktree).
  candidates=$(echo "$containers" \
    | while read -r dir; do
        [[ -n $dir ]] || continue
        find "$dir" -mindepth 2 -maxdepth 2 -name .git -type d -prune -exec dirname {} \;
        find "$dir" -mindepth 2 -maxdepth 2 -name .bare -type d -prune -exec dirname {} \; \
          | while read -r project; do
              find "$project" -mindepth 2 -maxdepth 2 -name .git -type f -exec dirname {} \;
            done
      done | sort)

  # --print-query emits the typed query on the first line so we can fall
  # back to zoxide when nothing in the list matches.
  fzf_out=$(echo "$candidates" | fzf --print-query --preview 'tree -C {} | head -200')

  query=$(echo "$fzf_out" | sed -n '1p')
  selected=$(echo "$fzf_out" | sed -n '2p')

  # No project/worktree matched the query - ask zoxide for a directory.
  if [[ -z $selected && -n $query ]]; then
    selected=$(zoxide query -- "$query" 2>/dev/null)
  fi
fi

if [[ -z $selected ]]; then
  exit 0
fi

# git-wt names a project's sessions and knows its main worktree, which is
# where the project folder itself opens. Anything else is named after its
# folder; tmux reads `.` and `:` in a target as window and pane separators.
if session=$(git-wt session "$selected" 2>/dev/null); then
  selected_name=${session%%$'\t'*}
  selected=${session#*$'\t'}
else
  selected_name=$(basename "$selected" | tr .: __)
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi

# switch-client needs a client to switch; from a plain shell, attach one.
if [[ -n $TMUX ]]; then
  tmux switch-client -t="$selected_name"
else
  tmux attach-session -t="$selected_name"
fi

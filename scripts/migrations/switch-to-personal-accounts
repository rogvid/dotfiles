#!/usr/bin/env bash
# switch-to-personal-accounts - one-off move of claude's personal account
# from ~/.claude-personal onto the default config dir, ~/.claude, which until
# now held the Flowtale login. switch-to-personal-accounts.md next to this
# script is the runbook: when and how to run it.
#
# Usage: switch-to-personal-accounts [--dry-run | --apply]
#
#   --dry-run   say what it would do, touch nothing (the default)
#   --apply     do it
#
# In order:
#   1. tmux: unset @agent-orchestrator-account, re-source ~/.tmux.conf, and
#      unset CLAUDE_CONFIG_DIR where a session (or the server) has it set
#      to ~/.claude-personal, so a claude started there lands on ~/.claude
#   2. narrow wipe: delete the Flowtale project folders in ~/.claude/projects
#      (named after ~/work/flowtale) and Flowtale's lines in history.jsonl
#   3. move-in from ~/.claude-personal: projects/, file-history/,
#      paste-cache/ and history.jsonl. Its Flowtale project folders are
#      dropped. A folder in both is merged file by file: a new file moves
#      in, an identical one is dropped, MEMORY.md gets the lines it lacks,
#      and any other clash keeps both, the incoming one as NAME.from-personal
#   4. login: ~/.claude-switch's .credentials.json into ~/.claude, its
#      oauthAccount into ~/.claude.json, which keeps its own project trust
#      entries and gains ~/.claude-personal's (a backup goes to
#      ~/.claude/backups first)
#   5. rm -rf ~/.claude-personal
#   6. mise bootstrap dotfiles apply, then agent-setup --check
#
# It refuses to apply while a claude runs on ~/.claude or ~/.claude-personal,
# before the dotfiles change that drops ~/.claude-personal is merged, or
# without a login in ~/.claude-switch. Once ~/.claude-personal is gone it
# has nothing left to do and says so.

set -euo pipefail

readonly default_dir="${HOME}/.claude"
readonly personal_dir="${HOME}/.claude-personal"
readonly switch_dir="${HOME}/.claude-switch"
readonly home_config="${HOME}/.claude.json"
readonly flowtale="${HOME}/work/flowtale"

apply=0
case "${1:---dry-run}" in
--dry-run) ;;
--apply) apply=1 ;;
-h | --help)
    sed -n '2,/^$/s/^# \{0,1\}//p' "$0"
    exit 0
    ;;
*)
    echo "usage: $(basename "$0") [--dry-run | --apply]" >&2
    exit 2
    ;;
esac
readonly apply

say() { printf '  %s\n' "$*"; }
head_() { printf '\n%s\n' "$*"; }

# Runs its arguments with --apply, else says it would.
act() {
    if ((apply)); then
        "$@"
    else
        say "would: $*"
    fi
}

# claude names a project folder after its path, every character but a
# letter or digit turned into "-".
slug() { printf '%s' "${1//[^A-Za-z0-9]/-}"; }
flowtale_slug="$(slug "${flowtale}")"
readonly flowtale_slug

is_flowtale_project() {
    [[ "$1" == "${flowtale_slug}" || "$1" == "${flowtale_slug}-"* ]]
}

# The config dir of each running claude, one a line: CLAUDE_CONFIG_DIR, or
# ~/.claude of the HOME it runs with.
running_config_dirs() {
    local pid environ dir home
    for pid in $(pgrep -x claude || true); do
        environ="$(tr '\0' '\n' <"/proc/${pid}/environ" 2>/dev/null)" || continue
        dir="$(sed -n 's/^CLAUDE_CONFIG_DIR=//p' <<<"${environ}")"
        home="$(sed -n 's/^HOME=//p' <<<"${environ}")"
        printf '%s %s\n' "${pid}" "$(realpath -m "${dir:-${home}/.claude}")"
    done
}

preflight() {
    local problems=() pid dir email
    head_ "preflight"
    if [[ ! -d "${personal_dir}" ]]; then
        say "${personal_dir} is gone: the switch is done, nothing to do"
        exit 0
    fi
    command -v jq >/dev/null || problems+=("jq is not installed")
    email="$(jq -r '.oauthAccount.emailAddress // empty' "${switch_dir}/.claude.json" 2>/dev/null || true)"
    if [[ -z "${email}" || ! -s "${switch_dir}/.credentials.json" ]]; then
        problems+=("no login in ${switch_dir}: run CLAUDE_CONFIG_DIR=${switch_dir} claude and /login")
    else
        say "${default_dir} will be logged in as: ${email}"
    fi
    if grep -q '\.claude-personal' "${HOME}/.config/mise/config.toml" 2>/dev/null; then
        problems+=("${HOME}/.config/mise/config.toml still links ${personal_dir}: merge feat/personal-default-agent-accounts first")
    fi
    while read -r pid dir; do
        if [[ "${dir}" == "$(realpath -m "${default_dir}")" || "${dir}" == "$(realpath -m "${personal_dir}")" ]]; then
            problems+=("claude pid ${pid} runs on ${dir}: exit it first")
        fi
    done < <(running_config_dirs)
    if ((${#problems[@]} == 0)); then
        say "ok"
        return 0
    fi
    for problem in "${problems[@]}"; do
        say "BLOCKER: ${problem}"
    done
    if ((apply)); then
        echo "refusing to apply" >&2
        exit 1
    fi
    say "(a dry run goes on; --apply would stop here)"
}

tmux_reset() {
    head_ "1. tmux"
    if ! tmux info >/dev/null 2>&1; then
        say "no tmux server: nothing to unset"
        return 0
    fi
    say "@agent-orchestrator-account is '$(tmux show-options -gqv @agent-orchestrator-account)'"
    act tmux set-option -gu @agent-orchestrator-account
    act tmux source-file "${HOME}/.tmux.conf"
    unset_personal_env -g
    local session
    while IFS= read -r session; do
        unset_personal_env -t "=${session}"
    done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null || true)
}

# Unsets CLAUDE_CONFIG_DIR in the tmux environment the arguments name (-g,
# or -t =SESSION) when it points at ~/.claude-personal.
unset_personal_env() {
    local value
    value="$(tmux show-environment "$@" CLAUDE_CONFIG_DIR 2>/dev/null || true)"
    [[ "${value#CLAUDE_CONFIG_DIR=}" == "${personal_dir}" ]] || return 0
    act tmux set-environment "$@" -u CLAUDE_CONFIG_DIR
}

# Lines of a history.jsonl whose project is not under ~/work/flowtale.
without_flowtale() {
    jq -c --arg f "${flowtale}" \
        'select((.project // "") as $p | ($p == $f or ($p | startswith($f + "/"))) | not)' "$@"
}

# Writes stdin to FILE through a temp file beside it, keeping FILE's mode.
replace_file() {
    local file="$1" tmp
    tmp="$(mktemp "${file}.XXXXXX")"
    cat >"${tmp}"
    if [[ -e "${file}" ]]; then
        chmod --reference="${file}" "${tmp}"
    fi
    mv "${tmp}" "${file}"
}

narrow_wipe() {
    local folder count=0 lines kept
    head_ "2. narrow wipe of Flowtale in ${default_dir}"
    for folder in "${default_dir}"/projects/*/; do
        folder="${folder%/}"
        if [[ ! -d "${folder}" ]] || ! is_flowtale_project "$(basename "${folder}")"; then
            continue
        fi
        count=$((count + 1))
        act rm -rf "${folder}"
    done
    say "${count} Flowtale project folders"
    if [[ -f "${default_dir}/history.jsonl" ]]; then
        lines="$(wc -l <"${default_dir}/history.jsonl")"
        kept="$(without_flowtale "${default_dir}/history.jsonl" | wc -l)"
        say "history.jsonl: drop $((lines - kept)) Flowtale lines of ${lines}"
        if ((apply)); then
            without_flowtale "${default_dir}/history.jsonl" | replace_file "${default_dir}/history.jsonl"
        fi
    fi
}

# Moves every file under SRC into DEST, keeping what DEST has (see the
# header for how a clash is settled). SRC is left with what was not moved.
merge_dir() {
    local src="$1" dest="$2" rel from to missing
    while IFS= read -r -d '' from; do
        rel="${from#"${src}"/}"
        to="${dest}/${rel}"
        if [[ ! -e "${to}" ]]; then
            say "move     ${rel}"
            if ((apply)); then
                mkdir -p "$(dirname "${to}")"
                mv "${from}" "${to}"
            fi
        elif cmp -s "${from}" "${to}"; then
            say "same     ${rel}"
        elif [[ "$(basename "${rel}")" == MEMORY.md ]]; then
            missing="$(grep -Fxv -f "${to}" "${from}" || true)"
            say "append   ${rel} ($(grep -c . <<<"${missing}" || true) lines)"
            if ((apply)) && [[ -n "${missing}" ]]; then
                [[ -z "$(tail -c 1 "${to}")" ]] || echo >>"${to}"
                printf '%s\n' "${missing}" >>"${to}"
            fi
        else
            say "CLASH    ${rel} - kept both, the incoming one as ${rel}.from-personal"
            act mv "${from}" "${to}.from-personal"
        fi
    done < <(find "${src}" -type f -print0 | sort -z)
}

move_in() {
    local folder name sub
    head_ "3. move-in from ${personal_dir}"
    for folder in "${personal_dir}"/projects/*/; do
        folder="${folder%/}"
        [[ -d "${folder}" ]] || continue
        name="$(basename "${folder}")"
        if is_flowtale_project "${name}"; then
            say "drop     projects/${name} (Flowtale)"
        elif [[ ! -e "${default_dir}/projects/${name}" ]]; then
            say "move     projects/${name}"
            if ((apply)); then
                mkdir -p "${default_dir}/projects"
                mv "${folder}" "${default_dir}/projects/${name}"
            fi
        else
            say "merge    projects/${name}:"
            merge_dir "${folder}" "${default_dir}/projects/${name}" | sed 's/^/  /'
        fi
    done
    for sub in file-history paste-cache; do
        [[ -d "${personal_dir}/${sub}" ]] || continue
        say "merge    ${sub}: $(find "${personal_dir}/${sub}" -type f | wc -l) files"
        merge_dir "${personal_dir}/${sub}" "${default_dir}/${sub}" | grep -v '^  move ' | sed 's/^/  /' || true
    done
    if [[ -f "${personal_dir}/history.jsonl" ]]; then
        say "history.jsonl: add $(without_flowtale "${personal_dir}/history.jsonl" | wc -l) lines, sorted by time"
        if ((apply)); then
            {
                [[ -f "${default_dir}/history.jsonl" ]] && cat "${default_dir}/history.jsonl"
                without_flowtale "${personal_dir}/history.jsonl"
            } | jq -s -c 'unique_by([.timestamp, .sessionId, .display]) | sort_by(.timestamp) | .[]' |
                replace_file "${default_dir}/history.jsonl"
            rm "${personal_dir}/history.jsonl"
        fi
    fi
}

login() {
    local backup
    head_ "4. login"
    act install -m 600 "${switch_dir}/.credentials.json" "${default_dir}/.credentials.json"
    backup="${default_dir}/backups/.claude.json.before-switch-$(date +%Y%m%d%H%M%S)"
    say "${home_config}: oauthAccount from ${switch_dir}, plus ${personal_dir}'s project trust; backup at ${backup}"
    if ((apply)); then
        [[ -f "${home_config}" ]] || install -m 600 <(echo '{}') "${home_config}"
        mkdir -p "$(dirname "${backup}")"
        cp -p "${home_config}" "${backup}"
        # An empty file slurps to [], so a missing personal config adds no trust.
        jq --slurpfile switch "${switch_dir}/.claude.json" \
            --slurpfile personal "$(realpath -e "${personal_dir}/.claude.json" 2>/dev/null || echo /dev/null)" \
            '.oauthAccount = $switch[0].oauthAccount
             | .projects = (($personal[0].projects // {}) + (.projects // {}))' \
            "${home_config}" | replace_file "${home_config}"
    fi
}

finish() {
    head_ "5. remove ${personal_dir}"
    act rm -rf "${personal_dir}"
    head_ "6. re-apply"
    act mise bootstrap dotfiles apply
    act agent-setup --check
}

main() {
    ((apply)) || echo "dry run - nothing will be modified; --apply to do it"
    preflight
    tmux_reset
    narrow_wipe
    move_in
    login
    finish
    ((apply)) && head_ "done - see switch-to-personal-accounts.md for what to check"
    return 0
}

main

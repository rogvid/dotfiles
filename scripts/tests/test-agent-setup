#!/usr/bin/env bash
# End-to-end checks for agent-setup's Claude Code skill links, on a throwaway
# HOME laid out like the real one: a skill pool in ~/.agents/skills and two
# Claude Code config dirs, ~/.claude and a ~/.claude-work account.
#
# curl and npx are stubs that fail loudly, so nothing here reaches the network:
# peon-ping is already "installed" and the manifest declares no skills.
#
# As on the real machine, ~/.agents is a link into the dotfiles repo, which
# tracks agent-sidebar; grilling stands in for a skill fetched with npx.
#
# Run: scripts/tests/test-agent-setup     (or `mise run test`)

set -euo pipefail

# As a pre-commit hook this runs with git's GIT_INDEX_FILE and friends set,
# which would point the throwaway dotfiles repo at this repo's index.
while IFS= read -r name; do
    unset "${name}"
done < <(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p')

repo="$(cd "$(dirname "$0")/../.." && pwd)"
readonly repo
scratch="$(mktemp -d)"
readonly scratch
readonly socket="agent-setup-test-$$"
tm() { env -u TMUX -u TMUX_PANE tmux -L "${socket}" -f /dev/null "$@"; }
trap 'tm kill-server 2>/dev/null || true; rm -rf "${scratch}"' EXIT

export HOME="${scratch}/home"
export DOTFILES="${scratch}/dotfiles"
readonly pool="${HOME}/.agents/skills"
readonly stubs="${scratch}/stubs"

mkdir -p "${stubs}" "${DOTFILES}/agents/.agents" "${HOME}/.claude/hooks/peon-ping"
for cmd in curl npx; do
    printf '#!/bin/sh\necho "%s must not run" >&2\nexit 1\n' "${cmd}" >"${stubs}/${cmd}"
    chmod +x "${stubs}/${cmd}"
done
export PATH="${stubs}:${repo}/scripts/.local/bin:${PATH}"
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
ln -s "${DOTFILES}/agents/.agents" "${HOME}/.agents"
printf '#!/bin/sh\n' >"${HOME}/.claude/hooks/peon-ping/peon.sh"
chmod +x "${HOME}/.claude/hooks/peon-ping/peon.sh"
printf '# nothing declared\n' >"${DOTFILES}/agents/.agents/skills.list"

for skill in agent-sidebar grilling; do
    mkdir -p "${pool}/${skill}"
    printf -- '---\nname: %s\n---\n' "${skill}" >"${pool}/${skill}/SKILL.md"
done
mkdir -p "${pool}/not-a-skill"
git init -q "${DOTFILES}"
git -C "${DOTFILES}" add agents/.agents/skills/agent-sidebar

# ~/.claude already has one link, a skill of its own named like a pool skill,
# a link to a pool skill since removed, and an unrelated broken link.
readonly claude="${HOME}/.claude/skills" work="${HOME}/.claude-work/skills"
mkdir -p "${claude}/synced" "${claude}/grilling" "${work}/synced"
ln -s ../../.agents/skills/agent-sidebar "${claude}/agent-sidebar"
ln -s ../../.agents/skills/gone "${claude}/gone"
ln -s /nowhere/else "${claude}/elsewhere"
printf 'own\n' >"${claude}/grilling/SKILL.md"

# The agent-sidebar plugin, as a stand-in setup that notes how it was run.
readonly plugin="${scratch}/plugin"
mkdir -p "${plugin}/bin"
printf '#!/bin/sh\necho "plugin setup $*" >>"%s/plugin-runs"\necho "linked   something"\n' "${scratch}" \
    >"${plugin}/bin/agent-sidebar-setup"
chmod +x "${plugin}/bin/agent-sidebar-setup"
export AGENT_SIDEBAR_PLUGIN="${plugin}"
# TPM is there already; its installer is a stand-in too.
mkdir -p "${HOME}/.tmux/plugins/tpm/bin"
printf '#!/bin/sh\necho "tpm install" >>"%s/plugin-runs"\n' "${scratch}" \
    >"${HOME}/.tmux/plugins/tpm/bin/install_plugins"
chmod +x "${HOME}/.tmux/plugins/tpm/bin/install_plugins"

# Settings: one file with values jq could damage, an account linking it the
# way the README says, an account with none, and one that is not valid JSON.
readonly settings="${HOME}/.claude/settings.json"
cat >"${settings}" <<'JSON'
{
  "theme": "dark",
  "big": 12345678901234567890,
  "decimal": 1.10,
  "text": "æ \"quoted\" é",
  "hooks": {
    "PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "keep-me"}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "keep-me-too"}]}]
  }
}
JSON
chmod 600 "${settings}"
cp -p "${settings}" "${scratch}/settings.before"
ln -s ../.claude/settings.json "${HOME}/.claude-work/settings.json"
mkdir -p "${HOME}/.claude-fresh" "${HOME}/.claude-broken"
printf 'not json\n' >"${HOME}/.claude-broken/settings.json"

failures=0
total=0

check() {
    local name="$1"
    shift
    total=$((total + 1))
    if "$@" 2>/dev/null; then
        printf 'ok    %s\n' "${name}"
    else
        printf 'FAIL  %s\n' "${name}"
        failures=$((failures + 1))
    fi
}

not() { ! "$@"; }
same() { [[ "$1" == "$2" ]]; }
links_to_pool() { [[ -L "$1" && "$(readlink -f "$1")" == "$(readlink -f "${pool}/$2")" ]]; }
contains() { [[ "$1" == *"$2"* ]]; }

out="$(agent-setup --check 2>&1)"
check "--check reports the missing link" contains "${out}" "would: link ${work}/agent-sidebar"
check "--check reports the dangling link" contains "${out}" "would: remove dangling ${claude}/gone"
check "--check links nothing" not test -e "${work}/agent-sidebar"
check "--check removes nothing" test -L "${claude}/gone"
check "--check installs no tmux plugins" not grep -q "tpm install" "${scratch}/plugin-runs"
check "--check runs the plugin's setup with --check" same "$(cat "${scratch}/plugin-runs")" "plugin setup --check"
check "--check reports the missing hook" contains "${out}" "would: add the AskUserQuestion hook to ${settings}"
check "--check leaves settings.json alone" cmp -s "${settings}" "${scratch}/settings.before"
check "--check creates no settings.json" not test -e "${HOME}/.claude-fresh/settings.json"

out="$(agent-setup 2>&1)"
gate_entries() {
    jq '[.hooks.PreToolUse[] | select(.matcher == "AskUserQuestion")] | length' "$1"
}
others() { jq -S 'del(.hooks.PreToolUse[] | select(.matcher == "AskUserQuestion"))' "$1"; }
check "the hook is added once" same "$(gate_entries "${settings}")" 1
check "every other key keeps its value" same "$(others "${settings}")" "$(jq -S . "${scratch}/settings.before")"
check "a large number stays exact" grep -q '"big": 12345678901234567890,' "${settings}"
check "a decimal stays as written" grep -q '"decimal": 1.10,' "${settings}"
check "settings.json keeps its mode" same "$(stat -c %a "${settings}")" 600
check "a linked settings.json stays a link" test -L "${HOME}/.claude-work/settings.json"
check "and is written only once" same "$(grep -c '^  added ' <<<"${out}")" 2
check "an account without settings gets the hook" same "$(gate_entries "${HOME}/.claude-fresh/settings.json")" 1
check "invalid settings are not overwritten" same "$(cat "${HOME}/.claude-broken/settings.json")" "not json"
check "and the run says so" \
    contains "${out}" "skipped  ${HOME}/.claude-broken/settings.json - not a valid settings file"
cp -p "${settings}" "${scratch}/settings.after"
check "an account's config dir gets every pool skill" links_to_pool "${work}/agent-sidebar" agent-sidebar
check "and the other one" links_to_pool "${work}/grilling" grilling
check "the links are relative, like npx skills makes them" \
    same "$(readlink "${work}/grilling")" ../../.agents/skills/grilling
check "the default config dir keeps its existing link" links_to_pool "${claude}/agent-sidebar" agent-sidebar
check "a dir without SKILL.md is not linked" not test -e "${work}/not-a-skill"
check "a skill Claude Code owns is not replaced" same "$(cat "${claude}/grilling/SKILL.md")" own
check "and the run says why it was skipped" contains "${out}" "skipped  ${claude}/grilling - not a symlink"
check "a link to a removed pool skill is pruned" not test -L "${claude}/gone"
check "an unrelated broken link is left alone" test -L "${claude}/elsewhere"
check "Claude Code's synced dir is left alone" test -d "${work}/synced"

check "a run installs the tmux plugins first" same "$(tail -2 "${scratch}/plugin-runs" | head -1)" "tpm install"
check "then runs the plugin's setup" same "$(tail -1 "${scratch}/plugin-runs")" "plugin setup "
check "and shows what it did" contains "${out}" "  linked   something"

undeclared() { sed -n '/in the pool but not declared/,/remove any/p' <<<"$1"; }
check "a skill dotfiles tracks is not offered for removal" \
    not contains "$(undeclared "${out}")" "  agent-sidebar"
check "an undeclared skill from elsewhere still is" contains "$(undeclared "${out}")" "  grilling"

out="$(agent-setup 2>&1)"
check "a second run changes nothing" \
    contains "${out}" "every Claude Code config dir links every pool skill"
check "a second run leaves settings.json byte-identical" cmp -s "${settings}" "${scratch}/settings.after"
check "and reports the hook as present" contains "${out}" "every valid settings.json has the hook"

# --- the registered command ---------------------------------------------------
registered="$(jq -r '.hooks.PreToolUse[] | select(.matcher == "AskUserQuestion") | .hooks[0].command' "${settings}")"
readonly registered
run_registered() {
    registered_status=0
    registered_out="$(env -u TMUX -u TMUX_PANE PATH=/usr/bin:/bin sh -c "${registered}" </dev/null 2>/dev/null)" \
        || registered_status=$?
}
run_registered
check "a missing hook script does not block the tool" same "${registered_status}:${registered_out}" "0:"
mkdir -p "${HOME}/.local/bin"
printf '#!/bin/sh\necho broken >&2\nexit 2\n' >"${HOME}/.local/bin/agent-question-gate"
chmod +x "${HOME}/.local/bin/agent-question-gate"
run_registered
check "nor does one that exits 2, Claude Code's block code" same "${registered_status}:${registered_out}" "0:"
printf '#!/bin/sh\necho resolved\n' >"${HOME}/.local/bin/agent-question-gate"
run_registered
check "it resolves outside tmux, without ~/.local/bin on PATH" same "${registered_out}" "resolved"
rm "${HOME}/.local/bin/agent-question-gate"

# --- the gate, on a throwaway tmux server --------------------------------------
# A real PreToolUse input recorded from Claude Code 2.1.330, with its ids and
# paths replaced.
read -r -d '' payload <<'JSON' || true
{
  "session_id": "00000000-0000-4000-8000-000000000000",
  "transcript_path": "/tmp/agent-setup-test/transcript.jsonl",
  "cwd": "/tmp/agent-setup-test",
  "scratchpad_dir": "/tmp/agent-setup-test/scratchpad",
  "prompt_id": "00000000-0000-4000-8000-000000000001",
  "permission_mode": "auto",
  "effort": {"level": "medium"},
  "hook_event_name": "PreToolUse",
  "tool_name": "AskUserQuestion",
  "tool_input": {
    "questions": [
      {
        "question": "Tea or coffee?",
        "header": "Drink",
        "options": [
          {"label": "Tea", "description": "Tea"},
          {"label": "Coffee", "description": "Coffee"}
        ],
        "multiSelect": false
      }
    ]
  },
  "tool_use_id": "toolu_00000000000000000000000000"
}
JSON
readonly payload

new_pane() { tm new-session -d -P -F '#{pane_id}' -s "$1" -x 80 -y 24 'sleep 600'; }
hugin_pane="$(new_pane hugin)"
worker_pane="$(new_pane worker)"
# Its name starts with "hugin", so only an exact match tells them apart.
lookalike_pane="$(new_pane hugin-notes)"
tmux_env="$(tm display-message -p -t "${worker_pane}" '#{socket_path},#{pid},0')"
readonly tmux_env worker_pane lookalike_pane

gate() {
    local pane="$1" input="$2"
    gate_status=0
    gate_out="$(TMUX="${tmux_env}" TMUX_PANE="${pane}" agent-question-gate <<<"${input}" 2>/dev/null)" \
        || gate_status=$?
}
allowed() { [[ "${gate_status}" == 0 && -z "${gate_out}" ]]; }
denied_towards() {
    [[ "${gate_status}" == 0 ]] && jq -e --arg pane "$1" '.hookSpecificOutput
        | .hookEventName == "PreToolUse" and .permissionDecision == "deny"
        and (.permissionDecisionReason | contains("agent-msg send " + $pane + " "))
        and (.permissionDecisionReason | contains("privacy, security, quality, simplicity or long-term maintainability"))
        and (.permissionDecisionReason | contains("then end your turn"))' <<<"${gate_out}" >/dev/null
}

gate "${worker_pane}" "${payload}"
check "another session is denied, pointed at Hugin's pane" denied_towards "${hugin_pane}"
gate "${lookalike_pane}" "${payload}"
check "so is a session whose name only starts with hugin" denied_towards "${hugin_pane}"
gate "${hugin_pane}" "${payload}"
check "Hugin's own pane is allowed" allowed

gate_status=0
gate_out="$(env -u TMUX -u TMUX_PANE agent-question-gate <<<"${payload}" 2>/dev/null)" || gate_status=$?
check "a session outside tmux is allowed" allowed

gate "${worker_pane}" "not json"
check "a malformed payload fails open" allowed
gate "${worker_pane}" ""
check "an empty payload fails open" allowed
gate "${worker_pane}" "$(jq '.tool_name = "Bash"' <<<"${payload}")"
check "another tool is not touched" allowed
gate "%999999" "${payload}"
check "a pane that no longer exists fails open" allowed

mkdir -p "${scratch}/broken-tmux"
printf '#!/bin/sh\nexit 1\n' >"${scratch}/broken-tmux/tmux"
chmod +x "${scratch}/broken-tmux/tmux"
gate_status=0
gate_out="$(PATH="${scratch}/broken-tmux:${PATH}" TMUX="${tmux_env}" TMUX_PANE="${worker_pane}" \
    agent-question-gate <<<"${payload}" 2>/dev/null)" || gate_status=$?
check "a failing tmux fails open" allowed

tm kill-session -t '=hugin'
gate "${worker_pane}" "${payload}"
check "without a hugin session the tool is allowed" allowed

hugin_pane="$(new_pane hugin)"
gate "${worker_pane}" "${payload}"
check "a restarted Hugin's new pane id is the one named" denied_towards "${hugin_pane}"

rm "${HOME}/.claude/hooks/peon-ping/peon.sh"
out="$(agent-setup --check 2>&1 || true)"
check "--check goes past a peon-ping it would install" contains "${out}" "agent-sidebar"

rm -r "${plugin}"
out="$(agent-setup --check 2>&1 || true)"
check "without the plugin it says where it comes from" contains "${out}" "rogvid/agent-sidebar"

printf '\n%s/%s passed\n' "$((total - failures))" "${total}"
((failures == 0))

#!/usr/bin/env bash
# End-to-end checks for scripts/migrations/switch-to-personal-accounts, on a
# throwaway HOME laid out like the real one before the switch: ~/.claude with
# Flowtale and personal projects, ~/.claude-personal, and a ~/.claude-switch
# holding the new login.
#
# tmux, mise and agent-setup are stand-ins that note how they were run. A
# stand-in claude (a copy of sleep) is a session running on ~/.claude.
#
# Run: scripts/tests/test-switch-to-personal-accounts     (or `mise run test`)

set -euo pipefail

repo="$(cd "$(dirname "$0")/../.." && pwd)"
readonly repo
readonly switch="${repo}/scripts/migrations/switch-to-personal-accounts"
scratch="$(mktemp -d)"
readonly scratch
claude_pid=""
trap '[[ -z "${claude_pid}" ]] || kill "${claude_pid}" 2>/dev/null; rm -rf "${scratch}"' EXIT

export HOME="${scratch}/home"
readonly default="${HOME}/.claude" personal="${HOME}/.claude-personal" login="${HOME}/.claude-switch"
readonly stubs="${scratch}/stubs" runs="${scratch}/runs"
slug() { printf '%s' "${1//[^A-Za-z0-9]/-}"; }
flowtale="$(slug "${HOME}/work/flowtale")"
readonly flowtale

mkdir -p "${stubs}"
for cmd in mise agent-setup; do
    printf '#!/bin/sh\necho "%s $*" >>"%s"\n' "${cmd}" "${runs}" >"${stubs}/${cmd}"
    chmod +x "${stubs}/${cmd}"
done
# tmux has two sessions, "on personal" with CLAUDE_CONFIG_DIR on
# ~/.claude-personal, and "plain" without; the server has it too.
cat >"${stubs}/tmux" <<EOF
#!/bin/sh
echo "tmux \$*" >>"${runs}"
case "\$*" in
"list-sessions"*) printf 'on personal\nplain\n' ;;
"show-environment -t =on personal CLAUDE_CONFIG_DIR" | "show-environment -g CLAUDE_CONFIG_DIR")
    echo "CLAUDE_CONFIG_DIR=${HOME}/.claude-personal" ;;
"show-environment"*) exit 1 ;;
esac
EOF
chmod +x "${stubs}/tmux"
export PATH="${stubs}:${PATH}"

# ~/.claude: the Flowtale login, Flowtale projects and personal ones; one of
# those (koyr) is also in ~/.claude-personal, with a clashing MEMORY.md.
mkdir -p "${default}/projects/${flowtale}-projects-webplatform/memory" \
    "${default}/projects/${flowtale}" \
    "${default}/projects/-home-orchestrator/memory" \
    "${default}/projects/-koyr/memory" \
    "${default}/file-history/aaa" "${default}/backups"
echo work >"${default}/projects/${flowtale}-projects-webplatform/s1.jsonl"
echo work >"${default}/projects/${flowtale}/s2.jsonl"
echo orchestrator >"${default}/projects/-home-orchestrator/memory/MEMORY.md"
printf '%s\n' '- [overview](overview.md)' '- [shared](shared.md)' >"${default}/projects/-koyr/memory/MEMORY.md"
echo theirs >"${default}/projects/-koyr/memory/notes.md"
echo same >"${default}/projects/-koyr/memory/same.md"
echo old >"${default}/file-history/aaa/v1"
echo '{"theme":"dark"}' >"${default}/settings.json"
echo flowtale-credentials >"${default}/.credentials.json"
cat >"${default}/history.jsonl" <<EOF
{"display":"work","timestamp":10,"project":"${HOME}/work/flowtale/projects/webplatform","sessionId":"w"}
{"display":"home","timestamp":30,"project":"${HOME}/personal/projects/koyr","sessionId":"h"}
{"display":"root","timestamp":50,"project":"${HOME}/work/flowtale","sessionId":"r"}
EOF
cat >"${HOME}/.claude.json" <<EOF
{"numStartups":3,"oauthAccount":{"emailAddress":"rda@flowtale.ai"},
 "projects":{"${HOME}/orchestrator":{"hasTrustDialogAccepted":true},"${HOME}/both":{"from":"default"}}}
EOF
chmod 600 "${HOME}/.claude.json"

mkdir -p "${personal}/projects/${flowtale}-projects-mercury" \
    "${personal}/projects/-mercury/memory" \
    "${personal}/projects/-koyr/memory" \
    "${personal}/file-history/bbb" "${personal}/paste-cache"
echo work >"${personal}/projects/${flowtale}-projects-mercury/s3.jsonl"
echo mercury >"${personal}/projects/-mercury/memory/MEMORY.md"
printf '%s\n' '- [shared](shared.md)' '- [goals](goals.md)' >"${personal}/projects/-koyr/memory/MEMORY.md"
echo mine >"${personal}/projects/-koyr/memory/notes.md"
echo same >"${personal}/projects/-koyr/memory/same.md"
echo new >"${personal}/file-history/bbb/v1"
echo pasted >"${personal}/paste-cache/abc.txt"
cat >"${personal}/history.jsonl" <<EOF
{"display":"mercury","timestamp":20,"project":"${HOME}/personal/projects/mercury","sessionId":"m"}
{"display":"old mercury","timestamp":40,"project":"${HOME}/work/flowtale/projects/mercury","sessionId":"o"}
EOF
cat >"${personal}/.claude.json" <<EOF
{"oauthAccount":{"emailAddress":"rda@flowtale.ai"},
 "projects":{"${HOME}/personal/projects/mercury":{"hasTrustDialogAccepted":true},"${HOME}/both":{"from":"personal"}}}
EOF

mkdir -p "${login}"
echo personal-credentials >"${login}/.credentials.json"
echo '{"oauthAccount":{"emailAddress":"rogvidarge@gmail.com"},"other":"ignored"}' >"${login}/.claude.json"

# The dotfiles change that drops ~/.claude-personal, not yet merged.
mkdir -p "${HOME}/.config/mise"
echo '"~/.claude-personal/CLAUDE.md" = {}' >"${HOME}/.config/mise/config.toml"

failures=0
total=0

check() {
    local name="$1"
    shift
    total=$((total + 1))
    if "$@" 2>/dev/null; then
        printf 'ok    %s\n' "${name}"
    else
        printf 'FAIL  %s\n' "${name}"
        failures=$((failures + 1))
    fi
}

not() { ! "$@"; }
same() { [[ "$1" == "$2" ]]; }
contains() { [[ "$1" == *"$2"* ]]; }
snapshot() { (cd "${HOME}" && find . -printf '%p %s %m\n' | sort && find . -type f -exec md5sum {} + | sort); }
ran() { grep -qxF "$1" "${runs}"; }
# A dry run may ask tmux what is set, and nothing else.
only_queries() {
    [[ ! -e "${runs}" ]] || ! grep -qvE '^tmux (info|show-options|show-environment|list-sessions)' "${runs}"
}
refuses() { ! "${switch}" --apply >/dev/null 2>&1; }

# --- refusals ----------------------------------------------------------------

before="$(snapshot)"
out="$("${switch}" 2>&1)"
check "a dry run is the default" contains "${out}" "dry run - nothing will be modified"
check "it names the account ~/.claude gets" contains "${out}" "logged in as: rogvidarge@gmail.com"
check "it flags the unmerged dotfiles change" contains "${out}" "BLOCKER: ${HOME}/.config/mise/config.toml still links"
check "and still shows the whole plan" contains "${out}" "6. re-apply"
check "a dry run touches nothing" same "$(snapshot)" "${before}"
check "nor runs anything but tmux queries" only_queries

check "--apply refuses before the merge" refuses
check "and touches nothing" same "$(snapshot)" "${before}"

echo '"~/.claude/CLAUDE.md" = {}' >"${HOME}/.config/mise/config.toml"
before="$(snapshot)"

cp "$(command -v sleep)" "${stubs}/claude"
env -u CLAUDE_CONFIG_DIR "${stubs}/claude" 60 &
claude_pid=$!
out="$("${switch}" 2>&1)"
check "a dry run flags a claude running on ~/.claude" contains "${out}" "BLOCKER: claude pid ${claude_pid} runs on ${default}"
check "--apply refuses while one does" refuses
check "and touches nothing" same "$(snapshot)" "${before}"
kill "${claude_pid}"
wait "${claude_pid}" 2>/dev/null || true
claude_pid=""

mv "${login}" "${scratch}/login"
before="$(snapshot)"
check "--apply refuses without the new login" refuses
check "and touches nothing" same "$(snapshot)" "${before}"
mv "${scratch}/login" "${login}"
before="$(snapshot)"

# --- the dry run ---------------------------------------------------------------

out="$("${switch}" --dry-run 2>&1)"
check "with nothing in the way there is no blocker" not contains "${out}" "BLOCKER"
check "it lists the Flowtale folders to delete" contains "${out}" "would: rm -rf ${default}/projects/${flowtale}-projects-webplatform"
check "it counts the Flowtale history lines" contains "${out}" "drop 2 Flowtale lines of 3"
check "it drops personal's Flowtale project" contains "${out}" "drop     projects/${flowtale}-projects-mercury (Flowtale)"
check "it reports a clash" contains "${out}" "CLASH    memory/notes.md"
check "a dry run touches nothing" same "$(snapshot)" "${before}"
check "nor runs anything but tmux queries" only_queries

# --- the switch ----------------------------------------------------------------

out="$("${switch}" --apply 2>&1)" || { echo "${out}"; exit 1; }

check "tmux unsets the orchestrator's account" ran "tmux set-option -gu @agent-orchestrator-account"
check "and re-sources tmux.conf" ran "tmux source-file ${HOME}/.tmux.conf"
check "unsets CLAUDE_CONFIG_DIR where a session points it at personal" \
    ran "tmux set-environment -t =on personal -u CLAUDE_CONFIG_DIR"
check "and on the server" ran "tmux set-environment -g -u CLAUDE_CONFIG_DIR"
check "but nowhere else" not grep -q "set-environment -t =plain" "${runs}"

check "Flowtale project folders are gone" not test -e "${default}/projects/${flowtale}-projects-webplatform"
check "the one named after ~/work/flowtale itself too" not test -e "${default}/projects/${flowtale}"
check "the orchestrator's history stays" test -f "${default}/projects/-home-orchestrator/memory/MEMORY.md"
check "a personal project moves in" same "$(cat "${default}/projects/-mercury/memory/MEMORY.md")" mercury
check "personal's Flowtale project does not" not test -e "${default}/projects/${flowtale}-projects-mercury"

memory="${default}/projects/-koyr/memory"
check "a MEMORY.md in both gets the lines it lacked, once" same "$(cat "${memory}/MEMORY.md")" \
    "$(printf '%s\n' '- [overview](overview.md)' '- [shared](shared.md)' '- [goals](goals.md)')"
check "a clashing file keeps ~/.claude's" same "$(cat "${memory}/notes.md")" theirs
check "and the incoming one beside it" same "$(cat "${memory}/notes.md.from-personal")" mine
check "an identical file stays as it was" same "$(cat "${memory}/same.md")" same

check "file-history merges" same "$(cat "${default}/file-history/aaa/v1" "${default}/file-history/bbb/v1")" "$(printf 'old\nnew')"
check "paste-cache moves in" test -f "${default}/paste-cache/abc.txt"

check "history: no Flowtale lines, personal's added, by time" same \
    "$(jq -r .display "${default}/history.jsonl" | paste -sd,)" "mercury,home"

check "the new login's credentials are copied" same "$(cat "${default}/.credentials.json")" personal-credentials
check "readable by the owner only" same "$(stat -c %a "${default}/.credentials.json")" 600
config="$(cat "${HOME}/.claude.json")"
check ".claude.json takes the new oauthAccount" same "$(jq -r .oauthAccount.emailAddress <<<"${config}")" rogvidarge@gmail.com
check "and nothing else from the new login" same "$(jq -r '.other // "none"' <<<"${config}")" none
check "keeps its own trust entries" same "$(jq -r ".projects[\"${HOME}/orchestrator\"].hasTrustDialogAccepted" <<<"${config}")" true
check "gains personal's" same "$(jq -r ".projects[\"${HOME}/personal/projects/mercury\"].hasTrustDialogAccepted" <<<"${config}")" true
check "its own winning where both have one" same "$(jq -r ".projects[\"${HOME}/both\"].from" <<<"${config}")" default
check "and the rest of it" same "$(jq -r .numStartups <<<"${config}")" 3
check "still readable by the owner only" same "$(stat -c %a "${HOME}/.claude.json")" 600
check "the old .claude.json is backed up" same \
    "$(jq -r .oauthAccount.emailAddress "${default}"/backups/.claude.json.before-switch-*)" rda@flowtale.ai
check "settings.json is untouched" same "$(cat "${default}/settings.json")" '{"theme":"dark"}'

check "the personal config dir is gone" not test -e "${personal}"
check "the switch login is left for Rogvi" test -f "${login}/.credentials.json"
check "dotfiles are re-applied" ran "mise bootstrap dotfiles apply"
check "and agent-setup checked" ran "agent-setup --check"

out="$("${switch}" --apply 2>&1)"
check "a second run has nothing to do" contains "${out}" "the switch is done, nothing to do"

printf '\n%s/%s passed\n' "$((total - failures))" "${total}"
((failures == 0))
